{
  "name": "@openmrs/esm-dhti-utils",
  "version": "4.0.0",
  "license": "MPL-2.0",
  "description": "Shared utilities for OpenMRS DHTI microfrontends",
  "main": "src/index.ts",
  "source": true,
  "scripts": {
    "lint": "eslint src --ext js,jsx,ts,tsx --max-warnings 0",
    "prettier": "prettier --write \"src/**/*.{ts,tsx}\" --list-different",
    "typescript": "tsc",
    "test": "jest --config jest.config.js --passWithNoTests",
    "coverage": "yarn test --coverage"
  },
  "browserslist": [
    "extends browserslist-config-openmrs"
  ],
  "keywords": [
    "openmrs",
    "microfrontends",
    "dhti",
    "utilities"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dermatologist/openmrs-esm-dhti.git"
  },
  "homepage": "https://github.com/dermatologist/openmrs-esm-dhti#readme",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/dermatologist/openmrs-esm-dhti/issues"
  },
  "dependencies": {
    "axios": "^1.13"
  },
  "peerDependencies": {
    "@openmrs/esm-framework": "*",
    "react": "18.x"
  },
  "devDependencies": {
    "@openmrs/esm-framework": "next",
    "@swc/cli": "^0.3.12",
    "@swc/core": "^1.3.68",
    "@swc/jest": "^0.2.36",
    "@testing-library/react": "^15.0.6",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.3.21",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "typescript": "^5.0.0"
  },
  "packageManager": "yarn@4.10.3"
}
